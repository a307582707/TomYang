# 示例变量 — 可提交；勿填真实密码
VIP=10.0.0.100
interface=eth0
etcd_servers=https://10.0.0.11:2379,https://10.0.0.12:2379,https://10.0.0.13:2379
INGRESS_VIP=10.0.0.200
INGRESS_CLASS_NAME=nginx
DEMO_WEB_HOST=demo.example.invalid
DEMO_WEB_IMAGE=nginx:1.27.5
TARGET_NAMESPACE=default
REGISTRY_MIRROR=mirror.example.invalid
HAPROXY_STATS_BIND=10.0.0.5
HAPROXY_MGMT_CIDR=10.0.0.0/24
# 敏感项请 export，不要写入本文件：
# ENCRYPT_SECRET / HAPROXY_STATS_PASSWORD / GRAFANA_ADMIN_PASSWORD / TOKEN_* / ALERTMANAGER_*
# HAProxy → apiserver backends (no real production IPs in git)
MASTER1_IP=10.0.0.11
MASTER2_IP=10.0.0.12
MASTER3_IP=10.0.0.13
METRICS_SERVER_IMAGE=registry.k8s.io/metrics-server/metrics-server:v0.7.2
MONITORING_NAMESPACE=monitoring
PROMETHEUS_OPERATOR_VERSION=v0.76.0
KUBE_PROMETHEUS_VERSION=v0.14.0
