DEMO_WEB_HOST=demo.example.test
DEMO_WEB_IMAGE=demo-web:1.0.0
FLUENT_BIT_NAMESPACE=logging
FLUENT_BIT_NS_LABEL_KEY=kubernetes.io/metadata.name
FLUENT_BIT_NS_LABEL_VALUE=logging
FLUENT_BIT_POD_LABEL_KEY=app
FLUENT_BIT_POD_LABEL_VALUE=fluent-bit
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ADMIN_USER=admin
