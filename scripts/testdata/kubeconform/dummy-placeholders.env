GRAFANA_NAMESPACE=monitoring
GRAFANA_NS_LABEL_KEY=kubernetes.io/metadata.name
GRAFANA_NS_LABEL_VALUE=monitoring
GRAFANA_POD_LABEL_KEY=app
GRAFANA_POD_LABEL_VALUE=grafana
GRAFANA_PVC_SIZE=5Gi
HAPROXY_STATS_PASSWORD=changeme
HAPROXY_STATS_USER=admin
INGRESS_CLASS_NAME=nginx
INGRESS_NS_LABEL_KEY=kubernetes.io/metadata.name
INGRESS_NS_LABEL_VALUE=ingress-nginx
